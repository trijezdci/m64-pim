(* BK 2026-10-18 : No occurrences of &, ~ and <> nor any octal literals *)

DEFINITION MODULE SuErrors;

FROM ShortTypes IMPORT
  ShortCard, ShortInt;

TYPE SourcePosition = RECORD line : ShortCard; col: ShortCard END;

VAR
  OK : BOOLEAN;
  UndefSourcePos : SourcePosition;

PROCEDURE OpenErrorFile;
(* Open the error message file. Aborts if unsuccessful. *)

PROCEDURE CloseErrorFile;
(* Close the error message file. *)

PROCEDURE ERROR 
  ( VAR msg : ARRAY OF CHAR; pos : SourcePosition );
(* Writes error message 'msg' for source position 'pos' to error file.
   Sets global variable 'OK' to false. *)

PROCEDURE ErrorMsgWithId
  ( VAR msg : ARRAY OF CHAR; VAR id: ARRAY OF CHAR; pos : SourcePosition );
(* Writes error message 'msg' for source position 'pos' to error file.
   If 'msg' contains any "@", it is subtituted by 'id'.
   Sets global variablt 'OK' to false. *)

PROCEDURE CompilerError ( VAR msg : ARRAY OF CHAR );
(* Emits error message 'msg' and aborts.  *)

PROCEDURE Assert ( cond : BOOLEAN );
(* Aborts if boolean expression passed in 'cond' is FALSE *)

PROCEDURE ErrorReport;
(* Writes list of sorted error messages *)

PROCEDURE InitErrorMsg;
(* Initialize. *)

END SuErrors.
